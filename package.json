{
  "name": "atelier-studio",
  "productName": "Atelier",
  "version": "0.2.0",
  "description": "A local-first project studio for photographers, filmmakers and designers: cull faster, learn to grade, tell better stories.",
  "main": "out/main/index.js",
  "author": "Atelier",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/fetch-models.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && node tests/e2e/smoke.mjs",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux dir --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@mediapipe/tasks-vision": "^1.2.2",
    "exiftool-vendored": "^39.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
